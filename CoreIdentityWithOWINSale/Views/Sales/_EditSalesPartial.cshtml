@model SalesCoreProjectWithIdentityViewCom.ViewModels.SalesViewModel

<div class="modal-header bg-warning text-dark">
    <h5 class="modal-title fw-bold mb-0">
        <i class="fa-solid fa-pen-to-square me-2"></i>Edit Sale
    </h5>
    <button type="button" class="btn-close btn-close-modal"></button>
</div>

<div class="modal-body bg-light">
    @using (Html.BeginForm("EditSale", "Sales", FormMethod.Post, new { id = "editSaleForm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

        @Html.HiddenFor(m => m.SalesId)
        <input type="hidden" name="oldClientImage" value="@Model.ClientImage" />

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-lg rounded-4 sale-card h-100">
                    <div class="card-body p-4">
                        <h5 class="text-warning fw-bold mb-4">
                            <i class="fa-solid fa-circle-info me-2"></i>Sale Information
                        </h5>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.ClientName, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.ClientName, new { @class = "form-control modern-input", placeholder = "Enter client name" })
                            @Html.ValidationMessageFor(m => m.ClientName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.TotalPrice, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.TotalPrice, new { @class = "form-control modern-input", placeholder = "Enter total price" })
                            @Html.ValidationMessageFor(m => m.TotalPrice, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.SaleDate, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.SaleDate, "{0:yyyy-MM-dd}", new { @class = "form-control modern-input", type = "date" })
                            @Html.ValidationMessageFor(m => m.SaleDate, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.MobileNo, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control modern-input", placeholder = "Enter mobile number" })
                            @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">
                                <i class="fa-solid fa-credit-card me-2 text-success"></i>Payment Method
                            </label>

                            @Html.DropDownListFor(
                            m => m.PaymentTypeId,
                                                new SelectList(Model.PaymentMethods, "PaymentTypeId", "PaymentType", Model.PaymentTypeId),
                                                "Select Payment Method",
                                                new { @class = "form-select modern-select" }
                                                )

                        @Html.ValidationMessageFor(m => m.PaymentTypeId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-check form-switch mb-4">
                        @Html.CheckBoxFor(m => m.IsPaid, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.IsPaid, new { @class = "form-check-label fw-semibold ms-2" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Preview Image</label>
                        <div class="mb-2">
                            <img id="imageFile"
                                 src="@Url.Content(string.IsNullOrEmpty(Model.ClientImage) ? "~/Images/noImg.jpg" : Model.ClientImage)"
                                 alt="Preview"
                                 class="img-thumbnail shadow-sm rounded-3"
                                 style="width:120px;height:120px;object-fit:cover;" />
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ProfileFile, new { @class = "form-label fw-semibold" })
                        <input type="file"
                               name="ProfileFile"
                               id="ProfileFile"
                               class="form-control modern-input"
                               accept=".jpg,.jpeg,.png"
                               onchange="readUrl(this)" />
                        @Html.ValidationMessageFor(m => m.ProfileFile, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 property-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-success fw-bold mb-0">
                            <i class="fa-solid fa-building me-2"></i>Edit Properties
                        </h5>
                        <button type="button" onclick="addProperty()" class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold">
                            <i class="fa-solid fa-plus me-1"></i>Add
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table id="ExTable" class="table table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Type</th>
                                    <th>Location</th>
                                    <th style="width:110px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Properties.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" name="Properties[@i].PropertyId" value="@Model.Properties[i].PropertyId" />
                                                <input type="text" name="Properties[@i].PropertyType" value="@Model.Properties[i].PropertyType" class="form-control modern-input" placeholder="Type" />
                                                <span class="text-danger small" data-valmsg-for="Properties[@i].PropertyType"></span>
                                            </td>
                                            <td>
                                                <input type="text" name="Properties[@i].Location" value="@Model.Properties[i].Location" class="form-control modern-input" placeholder="Location" />
                                                <span class="text-danger small" data-valmsg-for="Properties[@i].Location"></span>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-danger btn-sm rounded-pill px-3" onclick="deleteRow(this)">
                                                    <i class="fa-solid fa-trash me-1"></i>Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <input type="hidden" id="HIndex" value="@Model.Properties.Count" />
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer mt-4">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4 btn-close-modal">Close</button>
            <button type="submit" class="btn btn-success rounded-pill px-4">
                <i class="fa-solid fa-check me-2"></i>Save Changes
            </button>
        </div>
    }
</div>

<style>
    .modern-input,
    .modern-select {
        border-radius: 12px;
        transition: all .3s ease;
    }

        .modern-input:focus,
        .modern-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 10px rgba(13,110,253,.25);
        }

    .sale-card,
    .property-card {
        transition: all .3s ease;
    }

        .sale-card:hover,
        .property-card:hover {
            transform: translateY(-4px);
        }

    @@media (max-width: 767.98px) {
        .sale-card,
        .property-card {
            border-radius: 18px;
        }

        #ExTable th,
        #ExTable td {
            white-space: nowrap;
            font-size: 13px;
        }
    }
</style>

<script>
    function readUrl(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                $("#imageFile").attr("src", e.target.result);
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function deleteRow(btn) {
        $(btn).closest("tr").remove();
        updatePropertyIndex();
    }

    function updatePropertyIndex() {
        $("#ExTable tbody tr").each(function (index) {
            $(this).find("input, span[data-valmsg-for]").each(function () {
                const name = $(this).attr("name");
                const valmsg = $(this).attr("data-valmsg-for");

                if (name) {
                    $(this).attr("name", name.replace(/Properties\[\d+\]/, "Properties[" + index + "]"));
                }

                if (valmsg) {
                    $(this).attr("data-valmsg-for", valmsg.replace(/Properties\[\d+\]/, "Properties[" + index + "]"));
                }
            });
        });

        $("#HIndex").val($("#ExTable tbody tr").length);
    }

    function addProperty() {
        const index = $("#ExTable tbody tr").length;

        const newRow = `
        <tr>
            <td>
                <input type="hidden" name="Properties[${index}].PropertyId" value="0" />
                <input type="text" name="Properties[${index}].PropertyType" class="form-control modern-input" placeholder="Type" />
                <span class="text-danger small" data-valmsg-for="Properties[${index}].PropertyType"></span>
            </td>
            <td>
                <input type="text" name="Properties[${index}].Location" class="form-control modern-input" placeholder="Location" />
                <span class="text-danger small" data-valmsg-for="Properties[${index}].Location"></span>
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-danger btn-sm rounded-pill px-3" onclick="deleteRow(this)">
                    <i class="fa-solid fa-trash me-1"></i>Delete
                </button>
            </td>
        </tr>`;

        $("#ExTable tbody").append(newRow);
        updatePropertyIndex();
    }
</script>
