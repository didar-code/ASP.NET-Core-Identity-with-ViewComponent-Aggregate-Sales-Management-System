@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const totalSales = Number('@Model.TotalSales') || 0;
            const paidSales = Number('@Model.PaidSales') || 0;
            const unpaidSales = Number('@Model.UnpaidSales') || 0;
            const totalProperties = Number('@Model.TotalProperties') || 0;
            const totalUsers = Number('@Model.TotalUsers') || 0;
            const totalPayment = paidSales + unpaidSales;
            const paidPercent = totalPayment > 0 ? Math.round((paidSales / totalPayment) * 100) : 0;
            const unpaidPercent = totalPayment > 0 ? Math.round((unpaidSales / totalPayment) * 100) : 0;

            document.querySelectorAll('.counter').forEach(function (counter) {
                const target = parseFloat(counter.dataset.count) || 0;
                let current = 0;
                const increment = target / 45;
                const timer = setInterval(function () {
                    current += increment;
                    if (current >= target) { current = target; clearInterval(timer); }
                    counter.textContent = Number.isInteger(target) ? Math.round(current).toLocaleString() : current.toLocaleString(undefined, { maximumFractionDigits: 2 });
                }, 18);
            });

            const paidBar = document.querySelector('.progress-paid');
            const unpaidBar = document.querySelector('.progress-unpaid');
            if (paidBar) paidBar.style.setProperty('--target-width', paidPercent + '%');
            if (unpaidBar) unpaidBar.style.setProperty('--target-width', unpaidPercent + '%');

            const overviewCanvas = document.getElementById('salesOverviewChart');
            if (overviewCanvas && window.Chart) {
                new Chart(overviewCanvas, {
                    type: 'bar',
                    data: {
                        labels: ['Total Sales', 'Paid', 'Unpaid', 'Properties', 'Users'],
                        datasets: [{
                            label: 'Dashboard Count',
                            data: [totalSales, paidSales, unpaidSales, totalProperties, totalUsers],
                            backgroundColor: ['rgba(37,99,235,.75)','rgba(34,197,94,.75)','rgba(245,158,11,.75)','rgba(20,184,166,.75)','rgba(236,72,153,.75)'],
                            borderRadius: 14,
                            borderSkipped: false
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(148,163,184,.18)' } }, x: { grid: { display: false } } } }
                });
            }

            const donutCanvas = document.getElementById('paymentDonutChart');
            if (donutCanvas && window.Chart) {
                new Chart(donutCanvas, {
                    type: 'doughnut',
                    data: { labels: ['Paid', 'Unpaid'], datasets: [{ data: [paidSales, unpaidSales], backgroundColor: ['rgba(34,197,94,.85)', 'rgba(245,158,11,.85)'], borderColor: '#ffffff', borderWidth: 4, hoverOffset: 8 }] },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } } }
                });
            }
        });
    </script>
}
